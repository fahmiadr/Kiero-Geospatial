# --- General Configuration ---
NODE_ENV=production
FRONTEND_PORT=14170
BACKEND_PORT=13001
GATEWAY_PORT=13000
ENABLE_COORDINATE_DEBUG=false

# --- Database Connection ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
BACKEND_DATABASE_URL=postgresql://user:password@host:5432/backend_db?schema=public&connection_limit=10
GATEWAY_DATABASE_URL=postgresql://user:password@host:5432/gateway_db?schema=public&connection_limit=10

# --- URLs and Ports ---
# These are used by the backend/gateway to talk to each other or the world
GATEWAY_URL=http://localhost:13000
RESOURCE_SERVER_URL=http://backend:3001
# For local AI service running on host machine inside Docker, use: http://host.docker.internal:5008
AI_SERVICE_URL=https://localhost
AI_SERVICE_TOKEN=1234567890token!

# --- Frontend Build Variables ---
# Required for the React app build process
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
VITE_CLIENT_ID=your_client_id
VITE_APP_BASE_URL=/

# --- Keys ---
# Paths inside the container
GATEWAY_PRIVATE_KEY_PATH=/app/keys/gateway_private.pem
GATEWAY_PUBLIC_KEY_PATH=/app/keys/gateway_public.pem
