DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=8"

PORT=3000

# URL publik tempat gateway ini bisa diakses. Penting untuk klaim 'iss' dan 'aud'.
# Jangan pakai slash di akhir.
GATEWAY_URL="http://localhost:3000" #Ganti dengan URL publik di production

# Path ke kunci private/public milik gateway
GATEWAY_PRIVATE_KEY_PATH="./gateway_private.pem"
GATEWAY_PUBLIC_KEY_PATH="./gateway_public.pem"

# URL internal dari Resource Server (layanan backend) tujuan proxy
# Jangan pakai slash di akhir.
RESOURCE_SERVER_URL="http://localhost:3001"

# URL lengkap endpoint AI Service eksternal (full URL termasuk path)
# Jangan pakai slash di akhir.
AI_SERVICE_URL="http://localhost:3001"

# API Token untuk autentikasi ke AI Service eksternal
# Format header yang dikirim ke upstream: Authorization: token <nilai-ini>
AI_SERVICE_TOKEN="token-value"