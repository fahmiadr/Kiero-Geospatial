model email_inbound {
  id             BigInt    @id @default(autoincrement())
  email_id       String    @db.VarChar(50)
  interaction_id String?   @db.VarChar(50)
  ename          String?   @db.VarChar(150)
  efrom          String?
  eto            String?
  ecc            String?
  ebcc           String?
  esubject       String?
  ebody_text     String?
  ebody_html     String?
  agent_handle   String?   @db.VarChar(50)
  customer_id    String?   @db.VarChar(50)
  ticket_number  String?   @db.VarChar(50)
  direction      String?   @db.VarChar(10)
  status         String?   @db.VarChar(50)
  account_email  String?   @db.VarChar(150)
  date_email     DateTime? @db.Timestamptz(6)
  date_receive   DateTime? @db.Timestamptz(6)
  date_replied   DateTime? @db.Timestamptz(6)
