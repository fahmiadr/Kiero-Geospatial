model tickets {
  id                                  String                   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                         String                   @db.VarChar(50)
  ticket_number                       String                   @db.VarChar(50)
  status                              String                   @db.VarChar(50)
  category_id                         BigInt?
  category_sub_id                     BigInt?
  customer_id_merge                   String?                  @db.VarChar(50)
  customer_id_origin                  String?                  @db.VarChar(50)
  complaint_detail                    String?
  response_detail                     String?
  sla                                 Int?
  remark                              String?
  thread_id                           String?                  @db.VarChar(50)
  account_id                          String?                  @db.VarChar(150)
  account_name                        String?                  @db.VarChar(100)
  last_response_by                    String?                  @db.VarChar(50)
  last_response_at                    DateTime?                @db.Timestamptz(6)
  channel_source                      String                   @db.VarChar(50)
  channel_type                        String?                  @db.VarChar(50)
  closed_at                           DateTime?                @db.Timestamptz(6)
  closed_by                           String?                  @db.VarChar(50)
  created_at                          DateTime                 @db.Timestamptz(6)
  created_by                          String?                  @db.VarChar(50)
  assign_to_user                      String?                  @db.VarChar(50)
  assign_to_team                      Int?
  priority                            String?                  @db.VarChar(20)
  reference_id                        String?                  @db.VarChar(50)
  team_id                             Int?
  region_id                           Int?
  coordinates                         Unsupported("geometry")?
  notif_email                         Boolean?
  teams_tickets_assign_to_teamToteams teams?                   @relation("tickets_assign_to_teamToteams", fields: [assign_to_team], references: [id])
  categories                          categories?              @relation(fields: [category_id], references: [id])
  category_sub                        category_sub?            @relation(fields: [category_sub_id], references: [id])
  customers                           customers                @relation(fields: [customer_id], references: [customer_id])
  regions                             regions?                 @relation(fields: [region_id], references: [id])
  teams_tickets_team_idToteams        teams?                   @relation("tickets_team_idToteams", fields: [team_id], references: [id])

  @@id([id, status, created_at])
  @@unique([ticket_number, status, created_at])
  @@index([coordinates], map: "idx_coordinates_gist", type: Gist)
  @@index([assign_to_team])
  @@index([category_id])
  @@index([channel_source])
  @@index([closed_at])
  @@index([created_at(sort: Desc)])
  @@index([customer_id])
  @@index([region_id])
  @@index([status])
  @@index([team_id])
}

