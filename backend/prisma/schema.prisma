generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model aux_history {
  id       BigInt    @id @default(autoincrement())
  username String?   @db.VarChar(50)
  aux_id   Int?
  aux_name String?   @db.VarChar(100)
  aux_date DateTime? @db.Timestamptz(6)
}

model aux_status {
  id          Int       @id @default(autoincrement())
  aux_name    String?   @db.VarChar(100)
  created_at  DateTime? @db.Timestamptz(6)
  created_by  String?   @db.VarChar(50)
  description String?
  is_active   Boolean   @default(true)
}

model call_detail_records {
  id                  BigInt  @id @default(autoincrement())
  session_id          String? @db.VarChar(150)
  call_id             String? @db.VarChar(150)
  callee              String? @db.VarChar(50)
  callee_domain       String? @db.VarChar(150)
  caller              String? @db.VarChar(50)
  caller_display_name String? @db.VarChar(150)
  caller_domain       String? @db.VarChar(150)
  ring_time           Int?
  answered_time       Int?
  start_time          Int?
  ended_time          Int?
  ended_reason        String? @db.VarChar(150)
  event_type          String? @db.VarChar(50)
  direction           String? @db.VarChar(50)
  status_code         String? @db.VarChar(50)
  tenant_id           String? @db.VarChar(50)
  tenant_name         String? @db.VarChar(50)
}

model call_history {
  id             BigInt    @id @default(autoincrement())
  interaction_id String?   @db.VarChar(50)
  ticket_number  String?   @db.VarChar(50)
  agent_handle   String?   @db.VarChar(50)
  customer_id    String?   @db.VarChar(50)
  phone_number   String?   @db.VarChar(50)
  call_type      String?   @db.VarChar(20)
  datetime_start DateTime? @db.Timestamptz(6)
  datetime_end   DateTime? @db.Timestamptz(6)
}

model categories {
  id            BigInt    @id @default(autoincrement())
  category_id   String    @db.VarChar(20)
  description   String?   @db.VarChar(255)
  created_at    DateTime? @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  created_by    String?   @db.VarChar(50)
  updated_by    String?   @db.VarChar(50)
  category_name String    @db.VarChar(150)
  is_active     Boolean   @default(true)
  sort_order    Int       @default(0)
  tickets       tickets[]
}

model category_sub {
  id                BigInt    @id @default(autoincrement())
  category_sub_id   String    @db.VarChar(20)
  category_sub_name String    @db.VarChar(250)
  description       String?   @db.VarChar(250)
  created_at        DateTime? @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)
  created_by        String?   @db.VarChar(50)
  updated_by        String?   @db.VarChar(50)
  sort_order        Int       @default(0)
  is_active         Boolean   @default(true)
  category_id       BigInt?
  tickets           tickets[]
}

model channels {
  id           BigInt    @id @default(autoincrement())
  channel_type String?   @db.VarChar(100)
  description  String?
  created_by   String?   @db.VarChar(50)
  updated_by   String?   @db.VarChar(50)
  created_at   DateTime? @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  is_active    Boolean   @default(true)
  channel_name String?   @db.VarChar(50)
  sort_order   Int?
}

model customer_channels {
  customer_id    String?   @db.VarChar(50)
  value_channel  String?   @db.VarChar(255)
  origin_id      String?   @db.VarChar(50)
  detail_channel String?   @db.VarChar(150)
  created_at     DateTime? @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  created_by     String?   @db.VarChar(100)
  sync_to        String?   @db.VarChar(50)
  type_channel   String?   @db.VarChar(50)
  updated_by     String?   @db.VarChar(100)
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@index([customer_id, type_channel, value_channel, origin_id, sync_to])
}

model customer_type {
  id          Int       @id @default(autoincrement()) @db.SmallInt
  type_name   String?   @db.VarChar(50)
  description String?
  active      Int?      @db.SmallInt
  created_by  String?   @db.VarChar(50)
  updated_by  String?   @db.VarChar(50)
  created_at  DateTime? @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
}

model customers {
  customer_id   String    @unique @db.VarChar(50)
  customer_type String?   @db.VarChar(20)
  city          String?   @db.VarChar(50)
  province      String?   @db.VarChar(50)
  zip_code      String?   @db.VarChar(10)
  address       String?
  birth_date    DateTime? @db.Date
  gender        String?   @db.VarChar(50)
  phone_number  String?   @db.VarChar(50)
  mobile_number String?   @db.VarChar(50)
  other_number  String?   @db.VarChar(50)
  email         String?   @db.VarChar(50)
  account_id    String?   @db.VarChar(50)
  status        Int?      @db.SmallInt
  remark        String?
  sync_date     DateTime? @db.Timestamptz(6)
  source        String?   @db.VarChar(100)
  created_at    DateTime? @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  created_by    String?   @db.VarChar(50)
  updated_by    String?   @db.VarChar(50)
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_name String    @db.VarChar(150)
  district      String?   @db.VarChar(50)
  village       String?   @db.VarChar(50)
  is_active     Boolean?
  blacklist     Boolean?
  sync_to       String?   @db.VarChar(50)
  lat           Decimal?  @db.Decimal(11, 9)
  lng           Decimal?  @db.Decimal(12, 9)
  tickets       tickets[]

  @@index([created_at])
  @@index([phone_number, mobile_number, other_number, email, account_id])
}

model email_accounts {
  id         Int       @id @default(autoincrement())
  username   String?   @db.VarChar(255)
  password   String?   @db.VarChar(255)
  host       String?   @db.VarChar(255)
  port       Int?
  type       String?   @db.VarChar(50)
  created_at DateTime? @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  tls        Boolean?
  active     Boolean?

  @@index([username])
}

model email_attachments {
  id         BigInt    @id @default(autoincrement())
  email_id   String?   @db.VarChar(50)
  encode     String?
  filename   String?
  filetype   String?   @db.VarChar(100)
  direction  String?   @db.VarChar(50)
  created_at DateTime? @db.Timestamptz(6)
