  updated_at               DateTime? @db.Timestamptz(6)
  max_sms                  Int?
  max_email                Int?
  max_chat                 Int?
  max_facebook             Int?
  max_twitter              Int?
  max_instagram            Int?
  max_whatsapp             Int?
  last_distribute_chat     DateTime? @db.Timestamptz(6)
  last_distribute_email    DateTime? @db.Timestamptz(6)
  last_distribute_whatsapp DateTime? @db.Timestamptz(6)
  max_queue                Int?
