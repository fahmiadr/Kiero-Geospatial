model phone_prefix_regions {
  phone_prefix_id BigInt
  region_id       Int
  phone_prefixes  phone_prefixes @relation(fields: [phone_prefix_id], references: [id])
  regions         regions        @relation(fields: [region_id], references: [id])

  @@id([phone_prefix_id, region_id])
}

model phone_prefixes {
  id                   BigInt                 @id @default(autoincrement())
  prefix               String                 @unique @db.VarChar(50)
  description          String?
  parent_id            BigInt?
  phone_prefix_regions phone_prefix_regions[]
  phone_prefixes       phone_prefixes?        @relation("phone_prefixesTophone_prefixes", fields: [parent_id], references: [id])
  other_phone_prefixes phone_prefixes[]       @relation("phone_prefixesTophone_prefixes")

  @@index([prefix])
}

model priorities {
  id          Int       @id @default(autoincrement())
  priority    String?   @db.VarChar(50)
  description String?
  created_by  String?   @db.VarChar(50)
  updated_by  String?   @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  is_active   Boolean   @default(true)
  sla         Int?      @db.SmallInt
}

model regions {
  id                   Int                     @id @default(autoincrement())
  level                String?                 @db.VarChar(10)
  tipe_adm             String?                 @db.VarChar(3)
  nama                 String?                 @db.VarChar(50)
  kode_prov            String?                 @db.VarChar(3)
  kode_kab             String?                 @db.VarChar(11)
  kode_kec             String?                 @db.VarChar(11)
  luas                 Float?
  geom                 Unsupported("geometry")
  phone_prefix_regions phone_prefix_regions[]
  tickets              tickets[]

  @@index([geom], map: "idx_geom", type: Gist)
  @@index([level, kode_prov, kode_kab, kode_kec], map: "idx_hirarki")
  @@index([kode_kec, nama], map: "idx_kec_nama")
  @@index([kode_kab], map: "idx_kode_kab_ops")
  @@index([kode_kec], map: "idx_kode_kec_ops")
  @@index([kode_prov], map: "idx_kode_prov_ops")
  @@index([nama(ops: raw("gin_trgm_ops"))], map: "idx_nama_trgm", type: Gin)
}

