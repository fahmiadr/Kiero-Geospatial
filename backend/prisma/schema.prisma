  email                    Boolean?
  chat                     Boolean?
  facebook                 Boolean?
  twitter                  Boolean?
  instagram                Boolean?
  whatsapp                 Boolean?
  telegram                 Boolean?
  connected                Boolean?
  login_kick               Boolean?
