  @@index([date_email])
  @@index([email_id])
  @@index([interaction_id])
  @@index([ticket_number])
}

model email_notification {
  id             BigInt    @id @default(autoincrement())
  email_id       String    @db.VarChar(100)
  interaction_id String?   @db.VarChar(50)
  ename          String?   @db.VarChar(150)
  eto            String?
  efrom          String?
  ecc            String?
  ebcc           String?
  esubject       String?
  ebody_html     String?
  date_email     DateTime? @db.Timestamptz(6)
  date_sent      DateTime? @db.Timestamptz(6)
  ticket_number  String?   @db.VarChar(50)
  direction      String?   @db.VarChar(5)
  status         String?   @db.VarChar(50)
  agent_handle   String?   @db.VarChar(50)
  sent           Int?      @db.SmallInt
  sent_message   String?
  sent_cnt       Int?      @db.SmallInt
}

model email_outbound {
  id             BigInt    @id @default(autoincrement())
  email_id       String    @db.VarChar(100)
  interaction_id String?   @db.VarChar(50)
  ename          String?   @db.VarChar(150)
  eto            String?
