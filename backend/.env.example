DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=16"

PORT=3001

# URL issuer dari access_token, yaitu URL publik dari gateway.
# Ini digunakan untuk memverifikasi klaim 'iss' pada token.
# Pastikan tidak ada garis miring (slash) di akhir.
GATEWAY_ISSUER_URL="http://localhost:3000"

# Path ke PUBLIC KEY milik gateway.
# Backend menggunakan kunci ini untuk memverifikasi tanda tangan access_token.
# Path ini relatif dari direktori 'backend'. Pastikan file ini ada.
GATEWAY_PUBLIC_KEY_PATH="../geo-gateway/gateway_public.pem"